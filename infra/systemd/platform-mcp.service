[Unit]
Description=Platform MCP Server
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=__REPO_ROOT__/platform-mcp
EnvironmentFile=__REPO_ROOT__/platform-mcp/.env

ExecStart=__REPO_ROOT__/platform-mcp/.venv/bin/python \
    -m app.server

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target